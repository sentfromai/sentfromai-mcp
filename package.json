{
  "name": "sentfromai-mcp",
  "version": "0.5.0-beta.1",
  "mcpName": "ai.sentfrom/mcp",
  "description": "MCP server for SentFromAI — email infrastructure for AI agents. Create inboxes, send and reply, search, manage threads, webhooks and allow/block rules as native agent tools.",
  "type": "module",
  "main": "./lib.js",
  "types": "./lib.d.ts",
  "exports": {
    ".": "./lib.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "sentfromai-mcp": "server.js"
  },
  "files": [
    "server.js",
    "lib.js",
    "lib.d.ts",
    "README.md",
    "identity-server.js",
    "mcp-with-identity.json",
    "skills",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "email",
    "email-api",
    "ai-agents",
    "agent-tools",
    "sentfromai",
    "claude",
    "openclaw",
    "inbox",
    "smtp",
    "transactional-email",
    "claude-code",
    "claude-plugin",
    "gemini-cli",
    "cursor",
    "agent-email"
  ],
  "homepage": "https://docs.sentfrom.ai/guides/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentfromai/sentfromai-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sentfromai/sentfromai-mcp/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@agentlogin/mcp": "0.2.0-beta.1"
  },
  "peerDependenciesMeta": {
    "@agentlogin/mcp": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:verify": "node scripts/release.mjs verify"
  },
  "x-sentfromai-host-version": "0.4.1"
}
