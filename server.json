{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.sentfrom/mcp",
  "title": "SentFromAI Email MCP",
  "description": "Email for AI agents: inboxes, send/reply/forward, search, threads, webhooks — 21 SentFromAI tools.",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/sentfromai/sentfromai-mcp/main/assets/logo.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "repository": {
    "url": "https://github.com/sentfromai/sentfromai-mcp",
    "source": "github"
  },
  "websiteUrl": "https://docs.sentfrom.ai/guides/mcp",
  "version": "0.4.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "sentfromai-mcp",
      "version": "0.4.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SENTFROMAI_API_KEY",
          "description": "SentFromAI API key (sf_live_…) from https://console.sentfrom.ai",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "SENTFROMAI_BASE_URL",
          "description": "Override the API base URL (default https://api.sentfrom.ai)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.sentfrom.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <SentFromAI API key (sf_live_…) from https://console.sentfrom.ai>",
          "placeholder": "Bearer sf_live_…",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
